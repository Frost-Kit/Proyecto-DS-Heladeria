@model List<HeladeriaJackFrost.Models.Venta>

@{
    ViewData["Title"] = "Control de Ventas en Mostrador";
    var ingresosReales = Model?
        .Where(v => v.Estado == (int)HeladeriaJackFrost.Models.EstadoVenta.Completada
                 || v.Estado == (int)HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion)
        .Sum(v => v.Total) ?? 0;

    var ventaForm = ViewBag.VentaForm as HeladeriaJackFrost.ViewModels.VentaViewModel
                    ?? new HeladeriaJackFrost.ViewModels.VentaViewModel();
    bool abrirModal = (ViewBag.AbrirModalVenta as bool? ?? false)
                      || (TempData["AbrirModalAlCargar"] as bool? ?? false);
}

<div class="container mt-4 mb-4">
    <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-2 mb-3">
        <h2 class="mb-0">Listado de Transacciones</h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" asp-route-soloHoy="true" class="btn btn-outline-primary flex-fill flex-md-grow-0">Ver
                solo hoy</a>
                <a asp-action="Index" asp-route-soloHoy="false"
                   class="btn btn-outline-secondary flex-fill flex-md-grow-0">Ver todas</a>
                <button type="button" class="btn btn-success w-100 w-md-auto" data-bs-toggle="modal"
                        data-bs-target="#modalNuevaVenta">
                    Registrar Nueva Venta
                </button>
            </div>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- VISTA ESCRITORIO (Tabla) -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID Venta</th>
                        <th>Fecha y Hora</th>
                        <th>Productos (Cant. x Precio)</th>
                        <th>Total (Bs.)</th>
                        <th>Estado Actual</th>
                        <th class="text-center">Cambiar Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var venta in Model)
                        {
                            <tr>
                                <td>#@venta.IdVenta</td>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @foreach (var det in venta.Detalle)
                                    {
                                        <div>
                                            <strong>@det.IdProductoNavigation?.Nombre</strong>:
                                            @det.Cantidad u. x Bs. @det.PrecioUnitario
                                            @if (det.Descuento > 0)
                                            {
                                                <span class="text-danger">(-Bs. @det.Descuento)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold text-nowrap align-middle">Bs. @venta.Total</td>
                                <td>
                                    @switch ((HeladeriaJackFrost.Models.EstadoVenta)venta.Estado)
                                    {
                                        case HeladeriaJackFrost.Models.EstadoVenta.Completada:
                                            <span class="badge bg-success">1 - Completada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Pendiente:
                                            <span class="badge bg-warning text-dark">2 - Pendiente (Pago)</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion:
                                            <span class="badge bg-info text-dark">3 - En Preparación</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Anulada:
                                            <span class="badge bg-secondary">4 - Anulada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Reembolsada:
                                            <span class="badge bg-danger">5 - Reembolsada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="CambiarEstado" method="post" class="d-inline-flex gap-1 align-items-center">
                                        <input type="hidden" name="idVenta" value="@venta.IdVenta" />
                                        <select name="nuevoEstado" class="form-select form-select-sm pe-4"
                                                style="min-width: 175px;">
                                            <option value="1" selected="@(venta.Estado == 1)">1 - Completada</option>
                                            <option value="2" selected="@(venta.Estado == 2)">2 - Pendiente</option>
                                            <option value="3" selected="@(venta.Estado == 3)">3 - En Preparación</option>
                                            <option value="4" selected="@(venta.Estado == 4)">4 - Anulada</option>
                                            <option value="5" selected="@(venta.Estado == 5)">5 - Reembolsada</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay ventas registradas todavía.</td>
                        </tr>
                    }
                </tbody>
                @if (Model != null && Model.Any())
                {
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Ingresos reales en caja (Completadas + En Preparación):
                            </td>
                            <td colspan="3" class="fw-bold text-success fs-5">Bs. @ingresosReales</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <!-- VISTA CELULAR (Tarjetas responsivas) -->
        <div class="d-md-none">
            @if (Model != null && Model.Any())
            {
                foreach (var venta in Model)
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-dark text-black d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Venta #@venta.IdVenta</span>
                            <small>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                @foreach (var det in venta.Detalle)
                                {
                                    <div>
                                        <strong>@det.IdProductoNavigation?.Nombre</strong>:
                                        @det.Cantidad u. x Bs. @det.PrecioUnitario
                                        @if (det.Descuento > 0)
                                        {
                                            <span class="text-danger">(-Bs. @det.Descuento)</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-3">
                                <div>
                                    @switch ((HeladeriaJackFrost.Models.EstadoVenta)venta.Estado)
                                    {
                                        case HeladeriaJackFrost.Models.EstadoVenta.Completada:
                                            <span class="badge bg-success">1 - Completada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Pendiente:
                                            <span class="badge bg-warning text-dark">2 - Pendiente (Pago)</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion:
                                            <span class="badge bg-info text-dark">3 - En Preparación</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Anulada:
                                            <span class="badge bg-secondary">4 - Anulada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Reembolsada:
                                            <span class="badge bg-danger">5 - Reembolsada</span>
                                            break;
                                    }
                                </div>
                                <span class="fw-bold fs-5 text-success">Bs. @venta.Total</span>
                            </div>

                            <form asp-action="CambiarEstado" method="post" class="d-flex gap-2">
                                <input type="hidden" name="idVenta" value="@venta.IdVenta" />
                                <select name="nuevoEstado" class="form-select form-select-sm">
                                    <option value="1" selected="@(venta.Estado == 1)">1 - Completada</option>
                                    <option value="2" selected="@(venta.Estado == 2)">2 - Pendiente</option>
                                    <option value="3" selected="@(venta.Estado == 3)">3 - En Preparación</option>
                                    <option value="4" selected="@(venta.Estado == 4)">4 - Anulada</option>
                                    <option value="5" selected="@(venta.Estado == 5)">5 - Reembolsada</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary px-3">Guardar</button>
                            </form>
                        </div>
                    </div>
                }

                <div class="card bg-light shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">Ingresos reales en caja:</span>
                        <span class="fw-bold text-success fs-5">Bs. @ingresosReales</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center text-muted py-4">No hay ventas registradas todavía.</div>
                </div>
            }
        </div>
    </div>

    <!-- Ventana de Diálogo Modal -->
    @await Html.PartialAsync("_ModalCrearVenta", ventaForm)

   @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const modalEl = document.getElementById('modalNuevaVenta');
        const formVenta = document.getElementById('formNuevaVenta');
        const selectPersonal = document.getElementById('selectPersonal');
        const selectCliente = document.getElementById('selectCliente');
        const selectProducto = document.getElementById('selectProducto');
        const inputCantidad = document.getElementById('inputCantidad');
        const inputDescuento = document.getElementById('inputDescuento');
        const btnAgregarItem = document.getElementById('btnAgregarItem');
        const tbodyDetalle = document.getElementById('tbodyDetalleVenta');
        const contenedorInputs = document.getElementById('contenedorInputsDetalle');
        const textoTotal = document.getElementById('textoTotal');
        const contadorItems = document.getElementById('contadorItems');
        const alertaValidacion = document.getElementById('alertaValidacionVenta');
        const mensajeErrorCliente = document.getElementById('mensajeErrorCliente');

        // Lista dinámica en memoria (recupera ítems si el servidor devolvió error)
        let detallesEnMemoria = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ventaForm.Detalles.Select(d => new {
                idProducto = d.IdProducto,
                nombreProducto = d.NombreProducto,
                cantidad = d.Cantidad,
                precioUnitario = d.PrecioUnitario,
                descuento = d.Descuento
            })
        ));

        let formularioModificado = detallesEnMemoria.length > 0;
        let enviandoFormulario = false;

        function mostrarErrorModal(mensaje) {
            mensajeErrorCliente.textContent = mensaje;
            alertaValidacion.classList.remove('d-none');
        }

        function ocultarErrorModal() {
            mensajeErrorCliente.textContent = '';
            alertaValidacion.classList.add('d-none');
        }

        // Renderiza la tabla en memoria, genera inputs ocultos y recalcula totales
        function renderizarDetalle() {
            tbodyDetalle.innerHTML = '';
            contenedorInputs.innerHTML = '';

            if (detallesEnMemoria.length === 0) {
                tbodyDetalle.innerHTML = `
                    <tr id="filaVaciaDetalle">
                        <td colspan="6" class="text-center text-muted py-3">
                            Aún no hay productos agregados. Seleccione un producto y presione <strong>+ Agregar Ítem</strong>.
                        </td>
                    </tr>`;
                textoTotal.textContent = 'Bs. 0.00';
                contadorItems.textContent = '0 ítems';
                return;
            }

            let totalGeneral = 0;

            detallesEnMemoria.forEach((item, index) => {
                const subtotal = Math.max(0, (item.precioUnitario * item.cantidad) - item.descuento);
                totalGeneral += subtotal;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${item.nombreProducto}</td>
                    <td class="text-center fw-semibold">${item.cantidad}</td>
                    <td class="text-end">Bs. ${item.precioUnitario.toFixed(2)}</td>
                    <td class="text-end text-danger">${item.descuento > 0 ? '-Bs. ' + item.descuento.toFixed(2) : 'Bs. 0.00'}</td>
                    <td class="text-end fw-bold">Bs. ${subtotal.toFixed(2)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="quitarItem(${index})">
                            Quitar
                        </button>
                    </td>
                `;
                tbodyDetalle.appendChild(tr);

                // Inputs ocultos para enlazar List<DetalleItemViewModel> Detalles en ASP.NET Core
                contenedorInputs.insertAdjacentHTML('beforeend', `
                    <input type="hidden" name="Detalles[${index}].IdProducto" value="${item.idProducto}" />
                    <input type="hidden" name="Detalles[${index}].NombreProducto" value="${item.nombreProducto}" />
                    <input type="hidden" name="Detalles[${index}].Cantidad" value="${item.cantidad}" />
                    <input type="hidden" name="Detalles[${index}].PrecioUnitario" value="${item.precioUnitario}" />
                    <input type="hidden" name="Detalles[${index}].Descuento" value="${item.descuento}" />
                `);
            });

            textoTotal.textContent = 'Bs. ' + totalGeneral.toFixed(2);
            contadorItems.textContent = `${detallesEnMemoria.length} ${detallesEnMemoria.length === 1 ? 'ítem' : 'ítems'}`;
        }

        // Agregar producto a la lista en memoria con validaciones
        btnAgregarItem.addEventListener('click', () => {
            ocultarErrorModal();

            const opcion = selectProducto.options[selectProducto.selectedIndex];
            const idProducto = parseInt(selectProducto.value) || 0;
            const nombreProducto = opcion ? opcion.getAttribute('data-nombre') : '';
            const precioUnitario = parseFloat(opcion ? opcion.getAttribute('data-precio') : 0) || 0;
            const stockDisponible = parseInt(opcion ? opcion.getAttribute('data-stock') : 0) || 0;
            const cantidad = parseInt(inputCantidad.value);
            const descuento = parseFloat(inputDescuento.value) || 0;

            if (idProducto <= 0) {
                mostrarErrorModal('Seleccione un producto válido antes de agregarlo al detalle.');
                selectProducto.focus();
                return;
            }

            if (isNaN(cantidad) || cantidad <= 0) {
                mostrarErrorModal('La cantidad debe ser un número entero mayor a cero.');
                inputCantidad.focus();
                return;
            }

            if (descuento < 0) {
                mostrarErrorModal('El descuento no puede ser negativo.');
                inputDescuento.focus();
                return;
            }

            // Verificar si el producto ya está en la lista para acumular cantidad
            const existente = detallesEnMemoria.find(d => d.idProducto === idProducto);
            const cantidadTotal = (existente ? existente.cantidad : 0) + cantidad;

            if (cantidadTotal > stockDisponible) {
                mostrarErrorModal(`Stock insuficiente para "${nombreProducto}". Disponible: ${stockDisponible} u.`);
                inputCantidad.focus();
                return;
            }

            const subtotalEvaluado = (precioUnitario * cantidadTotal) - ((existente ? existente.descuento : 0) + descuento);
            if (subtotalEvaluado <= 0) {
                mostrarErrorModal('El descuento no puede igualar ni superar el subtotal del producto.');
                inputDescuento.focus();
                return;
            }

            if (existente) {
                existente.cantidad = cantidadTotal;
                existente.descuento += descuento;
            } else {
                detallesEnMemoria.push({
                    idProducto,
                    nombreProducto,
                    cantidad,
                    precioUnitario,
                    descuento
                });
            }

            formularioModificado = true;
            renderizarDetalle();

            // Limpiar controles de línea para el siguiente artículo
            selectProducto.value = '0';
            inputCantidad.value = '1';
            inputDescuento.value = '0';
            selectProducto.focus();
        });

        // Quitar producto de la lista en memoria
        window.quitarItem = function (index) {
            ocultarErrorModal();
            detallesEnMemoria.splice(index, 1);
            formularioModificado = detallesEnMemoria.length > 0;
            renderizarDetalle();
        };

        // Validación antes de enviar el formulario (Prueba 3: bloqueo amable de venta vacía)
        formVenta.addEventListener('submit', (e) => {
            ocultarErrorModal();

            if (!selectPersonal.value) {
                e.preventDefault();
                mostrarErrorModal('Por favor, seleccione el cajero en turno antes de confirmar.');
                selectPersonal.focus();
                return;
            }

            if (!selectCliente.value) {
                e.preventDefault();
                mostrarErrorModal('Por favor, seleccione un cliente antes de confirmar.');
                selectCliente.focus();
                return;
            }

            if (detallesEnMemoria.length === 0) {
                e.preventDefault();
                mostrarErrorModal('No puede confirmar una venta vacía. Agregue al menos un artículo al detalle.');
                selectProducto.focus();
                return;
            }

            enviandoFormulario = true;
        });

        formVenta.addEventListener('change', () => { formularioModificado = true; });

        modalEl.addEventListener('shown.bs.modal', () => {
            selectPersonal.focus();
        });

        modalEl.addEventListener('hide.bs.modal', (e) => {
            if (formularioModificado && !enviandoFormulario) {
                const confirmarSalida = confirm("Tienes artículos o datos cargados en esta venta. ¿Deseas cerrar y descartar los cambios?");
                if (!confirmarSalida) {
                    e.preventDefault();
                }
            }
        });

        document.addEventListener('keydown', (e) => {
            if (modalEl.classList.contains('show') && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                e.preventDefault();
                formVenta.requestSubmit();
            }
        });

        renderizarDetalle();

        @if (abrirModal)
        {
            <text>
                document.addEventListener('DOMContentLoaded', () => {
                    formularioModificado = true;
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                });
            </text>
        }
    </script>
}