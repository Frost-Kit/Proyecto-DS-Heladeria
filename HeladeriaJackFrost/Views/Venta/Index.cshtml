@model List<HeladeriaJackFrost.Models.Venta>

@{
    ViewData["Title"] = "Control de Ventas en Mostrador";
    var ingresosReales = Model?
        .Where(v => v.Estado == (int)HeladeriaJackFrost.Models.EstadoVenta.Completada
                 || v.Estado == (int)HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion)
        .Sum(v => v.Total) ?? 0;

    var ventaForm = ViewBag.VentaForm as HeladeriaJackFrost.ViewModels.VentaViewModel
                    ?? new HeladeriaJackFrost.ViewModels.VentaViewModel();
    bool abrirModal = (ViewBag.AbrirModalVenta as bool? ?? false)
                      || (TempData["AbrirModalAlCargar"] as bool? ?? false);
}

<div class="container mt-4 mb-4">
    <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-2 mb-3">
        <h2 class="mb-0">Listado de Transacciones</h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" asp-route-soloHoy="true" class="btn btn-outline-primary flex-fill flex-md-grow-0">Ver
                solo hoy</a>
                <a asp-action="Index" asp-route-soloHoy="false"
                   class="btn btn-outline-secondary flex-fill flex-md-grow-0">Ver todas</a>
                <button type="button" class="btn btn-success w-100 w-md-auto" data-bs-toggle="modal"
                        data-bs-target="#modalNuevaVenta">
                    Registrar Nueva Venta
                </button>
            </div>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- VISTA ESCRITORIO (Tabla) -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID Venta</th>
                        <th>Fecha y Hora</th>
                        <th>Productos (Cant. x Precio)</th>
                        <th>Total (Bs.)</th>
                        <th>Estado Actual</th>
                        <th class="text-center">Cambiar Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var venta in Model)
                        {
                            <tr>
                                <td>#@venta.IdVenta</td>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @foreach (var det in venta.Detalle)
                                    {
                                        <div>
                                            <strong>@det.IdProductoNavigation?.Nombre</strong>:
                                            @det.Cantidad u. x Bs. @det.PrecioUnitario
                                            @if (det.Descuento > 0)
                                            {
                                                <span class="text-danger">(-Bs. @det.Descuento)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold text-nowrap align-middle">Bs. @venta.Total</td>
                                <td>
                                    @switch ((HeladeriaJackFrost.Models.EstadoVenta)venta.Estado)
                                    {
                                        case HeladeriaJackFrost.Models.EstadoVenta.Completada:
                                            <span class="badge bg-success">1 - Completada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Pendiente:
                                            <span class="badge bg-warning text-dark">2 - Pendiente (Pago)</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion:
                                            <span class="badge bg-info text-dark">3 - En Preparación</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Anulada:
                                            <span class="badge bg-secondary">4 - Anulada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Reembolsada:
                                            <span class="badge bg-danger">5 - Reembolsada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="CambiarEstado" method="post" class="d-inline-flex gap-1 align-items-center">
                                        <input type="hidden" name="idVenta" value="@venta.IdVenta" />
                                        <select name="nuevoEstado" class="form-select form-select-sm pe-4"
                                                style="min-width: 175px;">
                                            <option value="1" selected="@(venta.Estado == 1)">1 - Completada</option>
                                            <option value="2" selected="@(venta.Estado == 2)">2 - Pendiente</option>
                                            <option value="3" selected="@(venta.Estado == 3)">3 - En Preparación</option>
                                            <option value="4" selected="@(venta.Estado == 4)">4 - Anulada</option>
                                            <option value="5" selected="@(venta.Estado == 5)">5 - Reembolsada</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay ventas registradas todavía.</td>
                        </tr>
                    }
                </tbody>
                @if (Model != null && Model.Any())
                {
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Ingresos reales en caja (Completadas + En Preparación):
                            </td>
                            <td colspan="3" class="fw-bold text-success fs-5">Bs. @ingresosReales</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <!-- VISTA CELULAR (Tarjetas responsivas) -->
        <div class="d-md-none">
            @if (Model != null && Model.Any())
            {
                foreach (var venta in Model)
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-dark text-black d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Venta #@venta.IdVenta</span>
                            <small>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                @foreach (var det in venta.Detalle)
                                {
                                    <div>
                                        <strong>@det.IdProductoNavigation?.Nombre</strong>:
                                        @det.Cantidad u. x Bs. @det.PrecioUnitario
                                        @if (det.Descuento > 0)
                                        {
                                            <span class="text-danger">(-Bs. @det.Descuento)</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-3">
                                <div>
                                    @switch ((HeladeriaJackFrost.Models.EstadoVenta)venta.Estado)
                                    {
                                        case HeladeriaJackFrost.Models.EstadoVenta.Completada:
                                            <span class="badge bg-success">1 - Completada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Pendiente:
                                            <span class="badge bg-warning text-dark">2 - Pendiente (Pago)</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.EnPreparacion:
                                            <span class="badge bg-info text-dark">3 - En Preparación</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Anulada:
                                            <span class="badge bg-secondary">4 - Anulada</span>
                                            break;
                                        case HeladeriaJackFrost.Models.EstadoVenta.Reembolsada:
                                            <span class="badge bg-danger">5 - Reembolsada</span>
                                            break;
                                    }
                                </div>
                                <span class="fw-bold fs-5 text-success">Bs. @venta.Total</span>
                            </div>

                            <form asp-action="CambiarEstado" method="post" class="d-flex gap-2">
                                <input type="hidden" name="idVenta" value="@venta.IdVenta" />
                                <select name="nuevoEstado" class="form-select form-select-sm">
                                    <option value="1" selected="@(venta.Estado == 1)">1 - Completada</option>
                                    <option value="2" selected="@(venta.Estado == 2)">2 - Pendiente</option>
                                    <option value="3" selected="@(venta.Estado == 3)">3 - En Preparación</option>
                                    <option value="4" selected="@(venta.Estado == 4)">4 - Anulada</option>
                                    <option value="5" selected="@(venta.Estado == 5)">5 - Reembolsada</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary px-3">Guardar</button>
                            </form>
                        </div>
                    </div>
                }

                <div class="card bg-light shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">Ingresos reales en caja:</span>
                        <span class="fw-bold text-success fs-5">Bs. @ingresosReales</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center text-muted py-4">No hay ventas registradas todavía.</div>
                </div>
            }
        </div>
    </div>

    <!-- Ventana de Diálogo Modal -->
    @await Html.PartialAsync("_ModalCrearVenta", ventaForm)

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const modalEl = document.getElementById('modalNuevaVenta');
        const formVenta = document.getElementById('formNuevaVenta');
        const selectPersonal = document.getElementById('selectPersonal');
        const selectProducto = document.getElementById('selectProducto');
        const inputCantidad = document.getElementById('inputCantidad');
        const inputPorcentajeDescuento = document.getElementById('inputPorcentajeDescuento');
        const btnAgregarProducto = document.getElementById('btnAgregarProducto');
        const tablaDetalleBody = document.getElementById('tablaDetalleBody');
        const inputsOcultosDetalle = document.getElementById('inputsOcultosDetalle');
        const textoBruto = document.getElementById('textoBruto');
        const textoDescuento = document.getElementById('textoDescuento');
        const textoTotal = document.getElementById('textoTotal');
        const errorCantidad = document.getElementById('errorCantidad');
        const errorDescuento = document.getElementById('errorDescuento');
        const btnConfirmarVenta = document.getElementById('btnConfirmarVenta');

        let detallesCarrito = [];
        let formularioModificado = false;
        let enviandoFormulario = false;

        function validarYCalcular() {
            const opcion = selectProducto.options[selectProducto.selectedIndex];
            const idProducto = parseInt(selectProducto.value) || 0;
            const stockTotal = parseInt(opcion ? opcion.getAttribute('data-stock') : 0) || 0;

            const yaEnCarrito = detallesCarrito
                .filter(d => d.idProducto === idProducto)
                .reduce((acc, d) => acc + d.cantidad, 0);
            const stockDisponible = Math.max(0, stockTotal - yaEnCarrito);

            const cantidad = parseInt(inputCantidad.value) || 0;
            const porcentaje = parseFloat(inputPorcentajeDescuento.value);

            let errorStock = false;
            let errorDesc = false;

            // 1. Validación dinámica de Stock
            if (idProducto > 0 && cantidad > stockDisponible) {
                inputCantidad.classList.add('is-invalid');
                errorCantidad.textContent = `No es posible comprar más de lo que hay en stock (disponible: ${stockDisponible} u.).`;
                errorStock = true;
            } else if (inputCantidad.value !== '' && cantidad <= 0) {
                inputCantidad.classList.add('is-invalid');
                errorCantidad.textContent = 'La cantidad debe ser un número mayor a cero.';
                errorStock = true;
            } else {
                inputCantidad.classList.remove('is-invalid');
                errorCantidad.textContent = '';
            }

            // 2. Validación dinámica CR-01: Descuento entre 0% y 20%
            if (isNaN(porcentaje) || porcentaje < 0 || porcentaje > 20) {
                inputPorcentajeDescuento.classList.add('is-invalid');
                errorDescuento.textContent = 'Por política de la heladería, el descuento debe estar entre 0% y un máximo de 20%.';
                errorDesc = true;
            } else {
                inputPorcentajeDescuento.classList.remove('is-invalid');
                errorDescuento.textContent = '';
            }

            btnAgregarProducto.disabled = errorStock || idProducto <= 0;
            btnConfirmarVenta.disabled = errorStock || errorDesc;

            // 3. Calcular Subtotal Bruto, Descuento y Total Final
            let subtotalBruto = detallesCarrito.reduce((sum, item) => sum + item.subtotal, 0);

            if (detallesCarrito.length === 0 && idProducto > 0 && !errorStock) {
                const precio = parseFloat(opcion.getAttribute('data-precio')) || 0;
                subtotalBruto = precio * Math.max(0, cantidad);
            }

            const pctValido = (!errorDesc && !isNaN(porcentaje)) ? porcentaje : 0;
            const montoDescuento = +(subtotalBruto * (pctValido / 100)).toFixed(2);
            const totalFinal = Math.max(0, subtotalBruto - montoDescuento);

            textoBruto.textContent = 'Bs. ' + subtotalBruto.toFixed(2);
            textoDescuento.textContent = '- Bs. ' + montoDescuento.toFixed(2);
            textoTotal.textContent = 'Bs. ' + totalFinal.toFixed(2);

            return !errorStock && !errorDesc;
        }

        function renderizarTablaDetalle() {
            tablaDetalleBody.innerHTML = '';
            inputsOcultosDetalle.innerHTML = '';

            if (detallesCarrito.length === 0) {
                tablaDetalleBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center text-muted py-2 small">
                            Seleccione un producto y presione <strong>+ Agregar</strong>.
                        </td>
                    </tr>`;
                validarYCalcular();
                return;
            }

            detallesCarrito.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${item.nombreProducto}</td>
                    <td class="text-center">${item.cantidad}</td>
                    <td class="text-end">Bs. ${item.precio.toFixed(2)}</td>
                    <td class="text-end fw-bold">Bs. ${item.subtotal.toFixed(2)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="quitarDetalle(${index})">&times;</button>
                    </td>
                `;
                tablaDetalleBody.appendChild(tr);

                inputsOcultosDetalle.innerHTML += `
                    <input type="hidden" name="Detalles[${index}].IdProducto" value="${item.idProducto}" />
                    <input type="hidden" name="Detalles[${index}].NombreProducto" value="${item.nombreProducto}" />
                    <input type="hidden" name="Detalles[${index}].Cantidad" value="${item.cantidad}" />
                    <input type="hidden" name="Detalles[${index}].Descuento" value="0" />
                `;
            });

            validarYCalcular();
        }

        function agregarProductoAlCarrito() {
            if (!validarYCalcular()) return false;

            const opcion = selectProducto.options[selectProducto.selectedIndex];
            const idProducto = parseInt(selectProducto.value) || 0;
            if (idProducto <= 0) return false;

            const nombreProducto = opcion.getAttribute('data-nombre');
            const precio = parseFloat(opcion.getAttribute('data-precio')) || 0;
            const cantidad = parseInt(inputCantidad.value) || 1;
            const subtotal = precio * cantidad;

            detallesCarrito.push({ idProducto, nombreProducto, precio, cantidad, subtotal });
            formularioModificado = true;

            selectProducto.value = "0";
            inputCantidad.value = 1;

            renderizarTablaDetalle();
            return true;
        }

        window.quitarDetalle = function(index) {
            detallesCarrito.splice(index, 1);
            renderizarTablaDetalle();
        };

        btnAgregarProducto.addEventListener('click', agregarProductoAlCarrito);
        selectProducto.addEventListener('change', validarYCalcular);
        inputCantidad.addEventListener('input', validarYCalcular);
        inputPorcentajeDescuento.addEventListener('input', validarYCalcular);

        formVenta.addEventListener('change', () => { formularioModificado = true; });
        formVenta.addEventListener('input', () => { formularioModificado = true; });

        formVenta.addEventListener('submit', (e) => {
            if (!validarYCalcular()) {
                e.preventDefault();
                return;
            }
            if (detallesCarrito.length === 0 && (parseInt(selectProducto.value) || 0) > 0) {
                if (!agregarProductoAlCarrito()) {
                    e.preventDefault();
                    return;
                }
            }
            enviandoFormulario = true;
        });

        modalEl.addEventListener('shown.bs.modal', () => {
            selectPersonal.focus();
            validarYCalcular();
        });

        modalEl.addEventListener('hide.bs.modal', (e) => {
            if (formularioModificado && !enviandoFormulario) {
                if (!confirm("Tienes datos ingresados en esta venta. ¿Deseas cerrar la ventana y descartar los cambios?")) {
                    e.preventDefault();
                }
            }
        });

        document.addEventListener('keydown', (e) => {
            if (modalEl.classList.contains('show') && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                e.preventDefault();
                formVenta.requestSubmit();
            }
        });

        @if (abrirModal)
        {
            <text>
            document.addEventListener('DOMContentLoaded', () => {
                formularioModificado = true;
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
            </text>
        }
    </script>
}