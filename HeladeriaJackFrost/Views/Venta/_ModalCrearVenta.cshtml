@model HeladeriaJackFrost.ViewModels.VentaViewModel
@{
    var productos = ViewBag.Productos as List<HeladeriaJackFrost.Models.Producto> ?? new();
}

<div class="modal fade" id="modalNuevaVenta" tabindex="-1" aria-labelledby="modalNuevaVentaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalNuevaVentaLabel">Registrar Venta en Mostrador (Maestro - Detalle)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form id="formNuevaVenta" asp-controller="Venta" asp-action="Crear" method="post">
                <div class="modal-body">
                    <!-- Alerta para errores de validación de borde o servidor -->
                    <div id="alertaValidacionVenta" class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                        <div asp-validation-summary="All" class="mb-0 small"></div>
                        <span id="mensajeErrorCliente" class="small fw-semibold"></span>
                    </div>

                    <!-- SECCIÓN 1: CABECERA DE VENTA (MAESTRO) -->
                    <div class="card border-secondary mb-3">
                        <div class="card-header bg-light fw-bold py-2">
                            1. Cabecera de Venta
                        </div>
                        <div class="card-body py-3">
                            <div class="row g-2">
                                <div class="col-12 col-md-4">
                                    <label asp-for="IdPersonal" class="form-label fw-semibold small mb-1">Cajero en Turno</label>
                                    <select asp-for="IdPersonal" id="selectPersonal" asp-items="ViewBag.Personal" class="form-select form-select-sm">
                                        <option value="">-- Seleccione el cajero --</option>
                                    </select>
                                    <span asp-validation-for="IdPersonal" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label asp-for="IdCliente" class="form-label fw-semibold small mb-1">Cliente</label>
                                    <select asp-for="IdCliente" id="selectCliente" asp-items="ViewBag.Clientes" class="form-select form-select-sm">
                                        <option value="">-- Seleccione un cliente --</option>
                                    </select>
                                    <span asp-validation-for="IdCliente" class="text-danger small"></span>
                                </div>

                                <div class="col-6 col-md-2">
                                    <label class="form-label fw-semibold small mb-1">Fecha y Hora</label>
                                    <input type="text" class="form-control form-control-sm bg-light" value="@Model.Fecha.ToString("dd/MM/yyyy HH:mm")" readonly />
                                </div>

                                <div class="col-6 col-md-2">
                                    <label asp-for="EstadoInicial" class="form-label fw-semibold small mb-1">Estado</label>
                                    <select asp-for="EstadoInicial" id="selectEstadoInicial" class="form-select form-select-sm">
                                        <option value="1">1 - Completada</option>
                                        <option value="2">2 - Pendiente</option>
                                        <option value="3">3 - En Preparación</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN 2: DETALLE DE VENTA EN MEMORIA -->
                    <div class="card border-primary mb-3">
                        <div class="card-header bg-light fw-bold py-2 d-flex justify-content-between align-items-center">
                            <span>2. Detalle de Artículos (En Memoria)</span>
                            <span class="badge bg-primary" id="contadorItems">0 ítems</span>
                        </div>
                        <div class="card-body py-3">
                            <!-- Controles para agregar ítem -->
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-12 col-md-5">
                                    <label for="selectProducto" class="form-label fw-semibold small mb-1">Producto Disponible</label>
                                    <select id="selectProducto" class="form-select form-select-sm">
                                        <option value="0" data-precio="0" data-stock="0" data-nombre="">-- Seleccione un producto --</option>
                                        @foreach (var prod in productos)
                                        {
                                            <option value="@prod.IdProducto"
                                                    data-precio="@prod.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-stock="@prod.Stock"
                                                    data-nombre="@prod.Nombre">
                                                @prod.Nombre - Bs. @prod.Precio.ToString("F2") (Stock: @prod.Stock)
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-4 col-md-2">
                                    <label for="inputCantidad" class="form-label fw-semibold small mb-1">Cantidad</label>
                                    <input id="inputCantidad" type="number" inputmode="numeric" min="1" value="1" class="form-control form-control-sm" />
                                </div>

                                <div class="col-4 col-md-2">
                                    <label for="inputDescuento" class="form-label fw-semibold small mb-1">Desc. (Bs.)</label>
                                    <input id="inputDescuento" type="number" inputmode="decimal" step="0.50" min="0" value="0" class="form-control form-control-sm" />
                                </div>

                                <div class="col-4 col-md-3 d-grid">
                                    <button type="button" id="btnAgregarItem" class="btn btn-primary btn-sm">
                                        + Agregar Ítem
                                    </button>
                                </div>
                            </div>

                            <!-- Tabla dinámica de ítems agregados -->
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-center" style="width: 90px;">Cant.</th>
                                            <th class="text-end" style="width: 120px;">P. Unit.</th>
                                            <th class="text-end" style="width: 110px;">Desc.</th>
                                            <th class="text-end" style="width: 130px;">Subtotal</th>
                                            <th class="text-center" style="width: 85px;">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyDetalleVenta">
                                        <tr id="filaVaciaDetalle">
                                            <td colspan="6" class="text-center text-muted py-3">
                                                Aún no hay productos agregados. Seleccione un producto y presione <strong>+ Agregar Ítem</strong>.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Contenedor de inputs ocultos para Model Binding en ASP.NET Core -->
                            <div id="contenedorInputsDetalle"></div>
                        </div>
                    </div>

                    <!-- TOTAL GENERAL AUTOMÁTICO -->
                    <div class="alert alert-info d-flex justify-content-between align-items-center mb-0">
                        <span>
                            <strong>Total General a Cobrar:</strong>
                            <small class="d-block text-muted">Atajos: <kbd>Esc</kbd> cancelar | <kbd>Ctrl+S</kbd> confirmar venta</small>
                        </span>
                        <span class="fs-4 fw-bold text-dark" id="textoTotal">Bs. 0.00</span>
                    </div>
                </div>

                <div class="modal-footer justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnConfirmarVenta" class="btn btn-success">Confirmar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>