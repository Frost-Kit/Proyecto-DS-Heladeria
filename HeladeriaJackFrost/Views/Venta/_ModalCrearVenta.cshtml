@model HeladeriaJackFrost.ViewModels.VentaViewModel
@{
    var productos = ViewBag.Productos as List<HeladeriaJackFrost.Models.Producto> ?? new();
}

<div class="modal fade" id="modalNuevaVenta" tabindex="-1" aria-labelledby="modalNuevaVentaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalNuevaVentaLabel">Registrar Venta en Mostrador</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form id="formNuevaVenta" asp-controller="Venta" asp-action="Crear" method="post">
                <div class="modal-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small">
                            @Html.ValidationSummary(false, "")
                        </div>
                    }

                    <!-- Datos de Cabecera (Maestro) -->
                    <div class="row">
                        <div class="col-12 col-md-4 mb-3">
                            <label asp-for="IdPersonal" class="form-label fw-semibold">Vendedor / Cajero</label>
                            <select asp-for="IdPersonal" id="selectPersonal" asp-items="ViewBag.Personal" class="form-select" required>
                                <option value="">-- Seleccione vendedor --</option>
                            </select>
                            <span asp-validation-for="IdPersonal" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4 mb-3">
                            <label asp-for="IdCliente" class="form-label fw-semibold">Cliente</label>
                            <select asp-for="IdCliente" id="selectCliente" asp-items="ViewBag.Clientes" class="form-select" required>
                                <option value="">-- Seleccione cliente --</option>
                            </select>
                            <span asp-validation-for="IdCliente" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4 mb-3">
                            <label asp-for="EstadoInicial" class="form-label fw-semibold">Estado de Operación</label>
                            <select asp-for="EstadoInicial" id="selectEstadoInicial" class="form-select">
                                <option value="1">1 - Completada</option>
                                <option value="2">2 - Pendiente (QR)</option>
                                <option value="3">3 - En Preparación</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-2" />

                    <!-- Selector de Producto (Detalle) -->
                    <div class="row align-items-start">
                        <div class="col-12 col-md-7 mb-2">
                            <label for="selectProducto" class="form-label fw-semibold">Producto Disponible</label>
                            <select id="selectProducto" class="form-select">
                                <option value="0" data-nombre="" data-precio="0" data-stock="0">-- Seleccione producto --</option>
                                @foreach (var prod in productos)
                                {
                                    <option value="@prod.IdProducto"
                                            data-nombre="@prod.Nombre"
                                            data-precio="@prod.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@prod.Stock">
                                        @prod.Nombre - Bs. @prod.Precio (Stock: @prod.Stock)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-2 mb-2">
                            <label for="inputCantidad" class="form-label fw-semibold">Cantidad</label>
                            <input id="inputCantidad" type="number" inputmode="numeric" min="1" value="1" class="form-control" />
                        </div>

                        <div class="col-6 col-md-3 mb-2 d-grid">
                            <label class="form-label d-none d-md-block">&nbsp;</label>
                            <button type="button" id="btnAgregarProducto" class="btn btn-primary">+ Agregar</button>
                        </div>
                    </div>

                    <div id="errorCantidad" class="text-danger small fw-semibold mb-2"></div>

                    <!-- Tabla de Productos Agregados -->
                    <div class="table-responsive mt-2 mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">P. Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-center">Quitar</th>
                                </tr>
                            </thead>
                            <tbody id="tablaDetalleBody">
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-2 small">
                                        Seleccione un producto y presione <strong>+ Agregar</strong>.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div id="inputsOcultosDetalle"></div>

                    <!-- Control de Descuento Global CR-01 (0% a 20%) -->
                    <div class="row align-items-center bg-light border rounded p-2 mx-0 mb-3">
                        <div class="col-12 col-md-5 mb-2 mb-md-0">
                            <label asp-for="PorcentajeDescuento" class="form-label fw-semibold mb-1">
                                Descuento sobre el total (%) <span class="badge bg-secondary">Máx. 20%</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <input asp-for="PorcentajeDescuento" id="inputPorcentajeDescuento" type="number" inputmode="decimal" step="1" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PorcentajeDescuento" id="errorDescuento" class="text-danger small fw-semibold d-block mt-1"></span>
                        </div>

                        <div class="col-12 col-md-7 text-md-end">
                            <div class="small text-muted">Subtotal Bruto: <strong id="textoBruto">Bs. 0.00</strong></div>
                            <div class="small text-danger">Descuento aplicado: <strong id="textoDescuento">- Bs. 0.00</strong></div>
                            <div class="fs-4 fw-bold text-success mt-1">Total Final: <span id="textoTotal">Bs. 0.00</span></div>
                        </div>
                    </div>

                    <small class="text-muted">Atajos: <kbd>Esc</kbd> cancelar | <kbd>Ctrl+S</kbd> guardar venta</small>
                </div>

                <div class="modal-footer justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnConfirmarVenta" class="btn btn-success">Confirmar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>