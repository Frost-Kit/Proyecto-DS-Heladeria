@model List<HeladeriaJackFrost.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Proveedores</h2>
        <a asp-controller="Proveedor" asp-action="Crear" class="btn btn-success">Registrar Nuevo Proveedor</a>
    </div>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Empresa</th>
                    <th>Nombre del Contacto</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdProveedor</td>
                        <td>@item.Nombre</td>
                        <td>@item.NombreContacto</td>
                        <td>@(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")</td>
                        <td>@(!string.IsNullOrEmpty(item.Direccion) ? item.Direccion : "N/A")</td>
                        <td>
                            <!-- considerar un swicth para ver que estado darle -->
                            @if (item.Estado == 1)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo (@item.Estado)</span>
                            }
                        </td>
                        <td class="text-center">
                            <!-- falta darles logica -->
                            <a asp-controller="Proveedor" asp-action="Actualizar" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay proveedores registrados todavía.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>