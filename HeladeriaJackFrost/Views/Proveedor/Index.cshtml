@model List<HeladeriaJackFrost.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    var filtroActual = ViewData["CurrentFilter"] as string;
    var mensajeExito = TempData["MensajeExito"] as string;
    var mensajeError = TempData["MensajeError"] as string;
    
    // talves esto para los css, para pensar señores...
    static (string Estilo, string Texto) EstadoBadge(int estado) => estado switch
    {
        1 => ("background-color: #ecfdf5; color: #047857; border: 1px solid #6ee7b7;", "Activo"),
        2 => ("background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;", "Inactivo"),
        3 => ("background-color: #fffbeb; color: #b45309; border: 1px solid #fcd34d;", "En Vacaciones"),
        4 => ("background-color: #ecfeff; color: #0e7490; border: 1px solid #67e8f9;", "Suspendido"),
        5 => ("background-color: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5;", "Eliminado"),
        _ => ("background-color: #1e293b; color: #ffffff; border: 1px solid #0f172a;", $"Desconocido ({estado})")
    };
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-between align-items-center gx-3 gy-2 mb-3">
        <h2 class="col-sm-6 mb-0 fw-bold">Proveedores</h2>
        <button type="button" class="btn btn-success col-sm-auto" data-bs-toggle="modal" data-bs-target="#modalProveedor">
            <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo Proveedor
        </button>
    </div>

    <form id="formBuscar" class="mb-3">
        <label for="buscar" class="col-12 form-label">Buscar proveedor</label>
        <div class="row align-items-center g-2">
            <div class="col-12 col-sm-6">
                <input type="text"
                       id="buscar"
                       class="form-control"
                       placeholder="Puede ingresar: empresa, contacto, telefono..."
                       autocomplete="off"
                       style="text-overflow: ellipsis"/>
            </div>
            <div class="col-auto col-sm-3 px-1">
                <button type="button" id="btnLimpiar" class="btn btn-secondary">
                    <i class="bi bi-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </form>
    
    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="col-sm-12 alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@mensajeExito</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="col-sm-12 alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@mensajeError</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <!-- 1. VISTA DE TARJETAS (menores a 1200px) -->
        <section class="d-block d-xl-none">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var item in Model)
                {
                    var (estiloBadge, textoEstado) = EstadoBadge(item.Estado);
                    var textoBusqueda = $"{item.Nombre} {item.NombreContacto} {item.Telefono} {item.Direccion}".ToLowerInvariant();

                    <div class="col" data-buscar="@textoBusqueda">
                        <article class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-secondary">
                                        ID <i class="bi bi-hash"></i>@item.IdProveedor
                                    </span>
                                    <span class="badge" style="@estiloBadge font-weight: 650; padding: 0.45rem 0.75rem; font-size: 0.8rem;">@textoEstado</span>
                                </div>

                                <h5 class="card-title fw-bold text-dark mb-3">
                                    <i class="bi bi-building text-secondary me-1"></i>@item.Nombre
                                </h5>

                                <div class="mb-4 text-secondary small flex-grow-1">
                                    <p class="mb-2">
                                        <i class="bi bi-person-fill text-muted me-1"></i><strong>Contacto:</strong> @item.NombreContacto
                                    </p>
                                    <p class="mb-2">
                                        <i class="bi bi-telephone-fill text-muted me-1"></i><strong>Teléfono:</strong> @(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")
                                    </p>
                                    <p class="mb-0">
                                        <i class="bi bi-geo-alt-fill text-muted me-1"></i><strong>Dirección:</strong> @(!string.IsNullOrEmpty(item.Direccion) ? item.Direccion : "N/A")
                                    </p>
                                </div>

                                <div class="mt-auto pt-3 border-top">
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-warning flex-fill d-flex align-items-center justify-content-center gap-1 text-dark fw-semibold"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalProveedor"
                                                data-id="@item.IdProveedor">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-danger flex-fill d-flex align-items-center justify-content-center gap-1 fw-semibold"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminar"
                                                data-id="@item.IdProveedor"
                                                data-nombre="@item.Nombre">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>

        <!-- 2. VISTA DE TABLA (desde 1200px) -->
        <section class="d-none d-xl-block">
            <div class="table-responsive">
                <table class="table table-striped table-hover shadow-sm align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-hash me-1"></i>ID</th>
                        <th><i class="bi bi-building me-1"></i>Empresa</th>
                        <th><i class="bi bi-person me-1"></i>Nombre del Contacto</th>
                        <th><i class="bi bi-telephone me-1"></i>Teléfono</th>
                        <th><i class="bi bi-geo-alt me-1"></i>Dirección</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var (estiloBadge, textoEstado) = EstadoBadge(item.Estado);
                        var textoBusqueda = $"{item.Nombre} {item.NombreContacto} {item.Telefono} {item.Direccion}".ToLowerInvariant();

                        <tr data-buscar="@textoBusqueda">
                            <td class="text-center fw-bold">@item.IdProveedor</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>@item.NombreContacto</td>
                            <td>@(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")</td>
                            <td>@(!string.IsNullOrEmpty(item.Direccion) ? item.Direccion : "N/A")</td>
                            <td class="text-center">
                                <span class="badge" style="@estiloBadge font-weight: 650; padding: 0.45rem 0.75rem; font-size: 0.8rem;">@textoEstado</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center align-items-center gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalProveedor"
                                            data-id="@item.IdProveedor"
                                            title="Editar">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.IdProveedor"
                                            data-nombre="@item.Nombre"
                                            title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <div id="alertaNoResultados"
         class="alert alert-light text-center text-muted py-5 shadow-sm border mt-4 mt-xl-0 @((Model?.Any() == true || !string.IsNullOrWhiteSpace(mensajeError)) ? "d-none" : "")"
         role="alert">
        <i class="bi bi-search display-6 d-block mb-3 text-secondary"></i>
        No se encontraron proveedores que coincidan con la búsqueda.
    </div>
</div>

<!-- Modal dinamico Crear / Editar: su contenido (_ProveedorForm) -->
<div class="modal fade" id="modalProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="contenidoProveedor"></div>
    </div>
</div>

<!-- Modal de eliminación -->
<div class="modal fade text-start" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Eliminar" method="post">
                <input type="hidden" name="id" id="eliminarId" />
                <input type="hidden" name="buscar" value="@filtroActual" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-wrap">
                    ¿Estás seguro de que deseas eliminar al proveedor <strong id="eliminarNombre"></strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-circle me-1"></i> Sí, eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const modalProveedor = document.getElementById('modalProveedor');
            const modalEliminar = document.getElementById('modalEliminar');
            const contenido = document.getElementById('contenidoProveedor');
            const urlFormulario = '@Url.Action("Formulario", "Proveedor")';
            let guardando = false;

            const spinner = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                </div>`;

            const errorCarga = `
                <div class="modal-body text-center py-4">
                    <p class="text-danger mb-3">No se pudo cargar el formulario. Inténtalo nuevamente.</p>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>`;

            // Cierra los tooltips del formulario anterior para no dejar globos huérfanos en el body
            function limpiarTooltips() {
                contenido.querySelectorAll('[data-bs-toggle="tooltip"]')
                    .forEach(el => bootstrap.Tooltip.getInstance(el)?.dispose());
            }

            // Pone HTML nuevo en el modal y lo prepara: validación + tooltips
            function cargarFormulario(html) {
                limpiarTooltips();
                contenido.innerHTML = html;

                const form = contenido.querySelector('form');
                if (form) $.validator.unobtrusive.parse(form);

                contenido.querySelectorAll('[data-bs-toggle="tooltip"]')
                    .forEach(el => new bootstrap.Tooltip(el));
            }

            function sesionExpirada(resp) {
                if (resp.redirected) {
                    window.location.href = resp.url;
                    return true;
                }
                return false;
            }

            // ----- Abrir modal Crear / Editar -----
            modalProveedor.addEventListener('show.bs.modal', async (event) => {
                const id = event.relatedTarget?.getAttribute('data-id');
                const url = id ? `${urlFormulario}?id=${encodeURIComponent(id)}` : urlFormulario;

                contenido.innerHTML = spinner;

                try {
                    const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (sesionExpirada(resp)) return;
                    if (!resp.ok) throw new Error(resp.status);

                    cargarFormulario(await resp.text());
                    contenido.querySelector('input[type="text"]')?.focus();
                } catch {
                    contenido.innerHTML = errorCarga;
                }
            });

            // ----- Atajo Ctrl + S (o Cmd + S en Mac) dentro del modal -----
            modalProveedor.addEventListener('keydown', (e) => {
                const esGuardar = (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's';
                if (!esGuardar) return;

                e.preventDefault();  // evita que el navegador abra "Guardar página"
                // requestSubmit dispara el evento submit (validación + fetch), a diferencia de submit()
                contenido.querySelector('#formProveedor')?.requestSubmit();
            });

            // ----- Guardar (Crear / Actualizar) -----
            contenido.addEventListener('submit', async (e) => {
                const form = e.target;
                if (form.id !== 'formProveedor') return;

                e.preventDefault();

                if (guardando) return;  // evita doble envío (clic + Ctrl+S)
                if (!$(form).valid()) return;

                guardando = true;
                const boton = form.querySelector('button[type="submit"]');
                boton.disabled = true;

                try {
                    const resp = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (sesionExpirada(resp)) return;

                    if (resp.ok) {
                        window.location.reload();
                        return;
                    }

                    if (resp.status === 422) {
                        cargarFormulario(await resp.text());
                        return;
                    }

                    throw new Error(resp.status);
                } catch {
                    boton.disabled = false;
                    const aviso = document.createElement('div');
                    aviso.className = 'alert alert-danger py-2';
                    aviso.textContent = 'Ocurrió un error inesperado al guardar. Inténtalo nuevamente.';
                    form.querySelector('.modal-body').prepend(aviso);
                } finally {
                    guardando = false;
                }
            });

            // ----- Modal de eliminación (uno solo, se llena con data-*) -----
            modalEliminar.addEventListener('show.bs.modal', (event) => {
                const boton = event.relatedTarget;
                document.getElementById('eliminarId').value = boton.getAttribute('data-id');
                document.getElementById('eliminarNombre').textContent = boton.getAttribute('data-nombre');
            });

            // Sin Enter para eliminar: el foco inicial va a "Cancelar".
            // Eliminar requiere un clic (o Tab + Enter a propósito sobre "Sí, eliminar").
            modalEliminar.addEventListener('shown.bs.modal', () => {
                modalEliminar.querySelector('.btn-secondary').focus();
            });
        })();

        // ----- Búsqueda en vivo con debounce (300 ms) -----
        (() => {
            const formBuscar = document.getElementById('formBuscar');
            const inputBuscar = document.getElementById('buscar');
            const btnLimpiar = document.getElementById('btnLimpiar');
            const alertaNoHay = document.getElementById('alertaNoResultados');
            const vistaTarjetas = document.querySelector('.d-block.d-xl-none');
            const vistaTabla = document.querySelector('.d-none.d-xl-block');
            let timeoutId = null;

            function filtrar() {
                const texto = inputBuscar.value.trim().toLowerCase();
                let visibles = 0;

                // Tarjetas y filas comparten el atributo data-buscar
                document.querySelectorAll('[data-buscar]').forEach(el => {
                    const coincide = el.dataset.buscar.includes(texto);
                    el.style.display = coincide ? '' : 'none';
                    if (coincide) visibles++;
                });

                const hayResultados = visibles > 0;

                // style.display tiene prioridad sobre las clases d-block / d-none de Bootstrap
                if (vistaTarjetas) vistaTarjetas.style.display = hayResultados ? '' : 'none';
                if (vistaTabla) vistaTabla.style.display = hayResultados ? '' : 'none';
                alertaNoHay.classList.toggle('d-none', hayResultados);
            }

            // Debounce: espera 300 ms desde la última tecla
            inputBuscar.addEventListener('input', () => {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(filtrar, 300);
            });

            // Enter o botón Buscar: filtra al instante, sin recargar la página
            formBuscar.addEventListener('submit', (e) => {
                e.preventDefault();
                clearTimeout(timeoutId);
                filtrar();
            });

            btnLimpiar.addEventListener('click', () => {
                inputBuscar.value = '';
                clearTimeout(timeoutId);
                filtrar();
                inputBuscar.focus();
            });
        })();
    </script>
}
