@model List<HeladeriaJackFrost.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    var filtroActual = ViewData["CurrentFilter"] as string;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
        <h2 class="mb-0 fw-bold">
            <!-- <i class="bi bi-truck text-primary me-2" style="color: var(--text-main) !important;"></i> -->Lista de Proveedores
        </h2>
        <a asp-controller="Proveedor" asp-action="Crear" class="btn btn-success">
            <!--<i class="bi bi-plus-circle me-1"></i> --> Registrar Nuevo Proveedor
        </a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-5">
            <label for="buscar" class="form-label">Buscar proveedor</label>
            <input type="text"
                   id="buscar"
                   name="buscar"
                   value="@filtroActual"
                   class="form-control"
                   placeholder="Buscar por empresa, contacto, telefono..."
                   autocomplete="off" />
        </div>
        <div class="col-auto px-1">
            <div class="d-flex h-100 gap-1">
                <button type="submit" class="btn btn-primary w-50">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-secondary w-50">
                    <i class="bi bi-eraser"></i> Limpiar
                </a>
            </div>
            
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <!-- 1. VISTA DE TARJETAS (Visible en pantallas menores a 1200px) -->
        <div class="d-block d-xl-none">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">
                                
                                <!-- Cabecera de la tarjeta: ID y Estado -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-secondary">
                                        ID <i class="bi bi-hash"></i>@item.IdProveedor
                                    </span>
                                    
                                    @{
                                        var (badgeStyleCard, textoEstadoCard) = item.Estado switch
                                        {
                                            1 => ("background-color: #ecfdf5; color: #047857; border: 1px solid #6ee7b7;", "Activo"),
                                            2 => ("background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;", "Inactivo"),
                                            3 => ("background-color: #fffbeb; color: #b45309; border: 1px solid #fcd34d;", "En Vacaciones"),
                                            4 => ("background-color: #ecfeff; color: #0e7490; border: 1px solid #67e8f9;", "Suspendido"),
                                            5 => ("background-color: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5;", "Eliminado"),
                                            _ => ("background-color: #1e293b; color: #ffffff; border: 1px solid #0f172a;", $"Desconocido ({item.Estado})")
                                        };
                                    }
                                    <span class="badge" style="@badgeStyleCard font-weight: 650; padding: 0.45rem 0.75rem; font-size: 0.8rem;">@textoEstadoCard</span>
                                </div>

                                <!-- Nombre de la Empresa -->
                                <h5 class="card-title fw-bold text-dark mb-3">
                                    <i class="bi bi-building text-secondary me-1"></i>@item.Nombre
                                </h5>

                                <!-- Detalles del Proveedor con Iconos -->
                                <div class="mb-4 text-secondary small flex-grow-1">
                                    <p class="mb-2">
                                        <i class="bi bi-person-fill text-muted me-1"></i><strong>Contacto:</strong> @item.NombreContacto
                                    </p>
                                    <p class="mb-2">
                                        <i class="bi bi-telephone-fill text-muted me-1"></i><strong>Teléfono:</strong> @(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")
                                    </p>
                                    <p class="mb-0">
                                        <i class="bi bi-geo-alt-fill text-muted me-1"></i><strong>Dirección:</strong> @(!string.IsNullOrEmpty(item.Direccion) ? item.Direccion : "N/A")
                                    </p>
                                </div>

                                <!-- Botones de Acción al fondo con Iconos -->
                                <div class="mt-auto pt-3 border-top">
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Proveedor"
                                           asp-action="Actualizar"
                                           asp-route-idProveedor="@item.IdProveedor"
                                           class="btn btn-sm btn-warning flex-fill d-flex align-items-center justify-content-center gap-1 text-dark fw-semibold">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>

                                        <button type="button" 
                                                class="btn btn-sm btn-danger flex-fill d-flex align-items-center justify-content-center gap-1 fw-semibold" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEliminar-@item.IdProveedor">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 2. VISTA DE TABLA CLÁSICA (Visible únicamente a partir de 1200px - 'xl') -->
        <div class="d-none d-xl-block">
            <div class="table-responsive">
                <table class="table table-striped table-hover shadow-sm align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="bi bi-hash me-1"></i>ID</th>
                            <th><i class="bi bi-building me-1"></i>Empresa</th>
                            <th><i class="bi bi-person me-1"></i>Nombre del Contacto</th>
                            <th><i class="bi bi-telephone me-1"></i>Teléfono</th>
                            <th><i class="bi bi-geo-alt me-1"></i>Dirección</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.IdProveedor</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.NombreContacto</td>
                                <td>@(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")</td>
                                <td>@(!string.IsNullOrEmpty(item.Direccion) ? item.Direccion : "N/A")</td>
                                <td class="text-center">
                                    @{
                                        var (badgeStyleTable, textoEstadoTable) = item.Estado switch
                                        {
                                            1 => ("background-color: #ecfdf5; color: #047857; border: 1px solid #6ee7b7;", "Activo"),
                                            2 => ("background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;", "Inactivo"),
                                            3 => ("background-color: #fffbeb; color: #b45309; border: 1px solid #fcd34d;", "En Vacaciones"),
                                            4 => ("background-color: #ecfeff; color: #0e7490; border: 1px solid #67e8f9;", "Suspendido"),
                                            5 => ("background-color: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5;", "Eliminado"),
                                            _ => ("background-color: #1e293b; color: #ffffff; border: 1px solid #0f172a;", $"Desconocido ({item.Estado})")
                                        };
                                    }
                                    <span class="badge" style="@badgeStyleTable font-weight: 650; padding: 0.45rem 0.75rem; font-size: 0.8rem;">@textoEstadoTable</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        <a asp-controller="Proveedor"
                                           asp-action="Actualizar"
                                           asp-route-idProveedor="@item.IdProveedor"
                                           class="btn btn-sm btn-warning" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <button type="button" 
                                                class="btn btn-sm btn-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEliminar-@item.IdProveedor"
                                                title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. MODALES DE ELIMINACIÓN -->
        @foreach (var item in Model)
        {
            <div class="modal fade text-start" id="modalEliminar-@item.IdProveedor" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body text-wrap">
                            ¿Estás seguro de que deseas eliminar al proveedor <strong>@item.Nombre</strong>?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </button>
                            <form asp-action="Eliminar" asp-route-id="@item.IdProveedor" method="post">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-check-circle me-1"></i> Sí, eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light text-center text-muted py-5 shadow-sm border" role="alert">
            <i class="bi bi-search display-6 d-block mb-3 text-secondary"></i>
            No se encontraron proveedores que coincidan con la búsqueda.
        </div>
    }
</div>