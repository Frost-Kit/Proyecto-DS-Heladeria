@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger" role="alert">
    <h1 class="h4 alert-heading">No se pudo completar la solicitud</h1>
    <p class="mb-0">Ocurrió un problema al procesar la información. Verifica la conexión e inténtalo nuevamente en unos minutos.</p>
</div>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de referencia:</strong> <code>@Model.RequestId</code>
    </p>
}

<button type="button" class="btn btn-outline-primary" onclick="window.location.reload()">
    <i class="bi bi-arrow-clockwise me-1"></i>Intentar nuevamente
</button>
