@model HeladeriaJackFrost.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión - Heladeria Jack Frost";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="login-wrapper">
        <div class="login-card shadow-lg">
            
            <div class="login-header text-center text-white">
                <i class="bi bi-snow2 display-5 mb-2"></i>
                <h3 class="fw-bold mb-0">Jack Frost</h3>
                <p class="text-white-50 small mb-0">Sistema de Gestión de Heladería</p>
            </div>

            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="EmailOrUser" class="form-control" id="floatingInput" placeholder="usuario" />
                        <label asp-for="EmailOrUser"><i class="bi bi-person me-1"></i> Usuario o Correo</label>
                        <span asp-validation-for="EmailOrUser" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="********" />
                        <label asp-for="Password"><i class="bi bi-lock me-1"></i> Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMeCheck">
                            Recordar sesión en este equipo
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg py-2 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                        </button>
                    </div>

                </form>
            </div>

            <div class="card-footer text-center py-3 bg-light border-0">
                <small class="text-muted">&copy; 2026 - Heladería Jack Frost</small>
            </div>

        </div>
    </div>

    <!-- Scripts de validación -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>