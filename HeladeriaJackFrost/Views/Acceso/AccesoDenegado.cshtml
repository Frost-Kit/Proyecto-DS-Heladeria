@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heladería Jack Frost</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--bg-body); margin: 0; font-family: system-ui, -apple-system, sans-serif;">

    <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="card shadow-lg border-0 p-5 text-center" style="max-width: 480px; width: 100%; border-radius: var(--radius-lg); background-color: var(--bg-surface);">
            
            <!-- Icono -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 50%; background-color: rgba(217, 83, 101, 0.12); color: var(--danger-color);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 1.493c.664-.414 1.472-.835 2.284-1.187C10.686.093 11.43 0 12 0c1.84 0 3.092.529 3.877 1.195.75.64 1.104 1.487 1.104 2.61v3.085c0 3.845-.702 7.125-1.481 9.34a.983.983 0 0 1-.922.67H2.478a.983.983 0 0 1-.922-.67C.772 13.72 0 10.44 0 6.565V3.805c0-1.123.355-1.97 1.104-2.61C1.892.529 3.144 0 4.984 0c.57 0 1.315.093 1.716.306.812.352 1.62.773 2.284 1.187zM6.864 7.42a.925.925 0 0 0-.585.875v1.898c0 .513.415.93.925.93h1.612c.51 0 .925-.417.925-.93V8.295a.925.925 0 0 0-.585-.875 1.34 1.34 0 0 0-.756-.05 1.34 1.34 0 0 0-.756.05zM9 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                </div>
            </div>

            <!-- Títulos -->
            <h2 class="fw-bold mb-2" style="color: var(--text-main);">Acceso Restringido</h2>
            <p class="text-muted mb-4" style="font-size: 0.95rem;">
                Lo sentimos, tu usuario no cuenta con los permisos necesarios para ingresar a este módulo de la heladería.
            </p>

            <!-- Botones de acción -->
            <div class="d-grid gap-2">
                <a class="btn text-white py-2" asp-controller="Home" asp-action="Index" style="background-color: var(--primary-color); border-radius: var(--radius-md); font-weight: 500;">
                    Volver al Inicio
                </a>
                <a class="btn py-2" asp-controller="Acceso" asp-action="Login" style="background-color: var(--bg-soft); color: var(--text-main); border: 1px solid var(--border-color); border-radius: var(--radius-md); font-weight: 500;">
                    Iniciar sesión con otra cuenta
                </a>
            </div>
        </div>
    </div>

</body>
</html>