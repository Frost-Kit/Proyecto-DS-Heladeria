@model HeladeriaJackFrost.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Panel de Cliente";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <!-- Tarjeta de Perfil / Fidelidad -->
            <div class="card shadow-lg border-0 text-center p-4" style="border-radius: var(--radius-xl);">
                
                <div class="card-body">
                    <!-- Icono decorativo -->
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px; border-radius: 50%; background-color: var(--primary-light); color: var(--primary-color);">
                            <i class="bi bi-person-heart" style="font-size: 38px;"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-1" style="color: var(--text-main);">@Model.Nombre @Model.ApellidoPat @Model.ApellidoMat</h3>
                    <p class="text-muted small mb-4">@Model.Email</p>

                    <!-- Puntos de Fidelidad -->
                    <div class="p-3 mb-4" style="background-color: var(--bg-soft); border-radius: var(--radius-md); border: 1px dashed var(--border-strong);">
                        <span class="d-block text-muted small text-uppercase fw-bold mb-1">Puntos de Fidelidad Actuales</span>
                        <h1 class="fw-bold text-success mb-0" style="font-size: 2.5rem;">
                            <i class="bi bi-star-fill text-warning me-1" style="font-size: 1.8rem;"></i>@Model.PuntosDeCliente
                        </h1>
                    </div>

                    <!-- Acciones Inteligentes según quién visite la vista -->
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("Administrador"))
                        {
                            @* Si es el administrador inspeccionando, se le da la opción de volver a la gestión *@
                            <a asp-action="Index" class="btn btn-outline-primary py-2">
                                <i class="bi bi-arrow-left me-1"></i> Volver a la Lista de Clientes
                            </a>
                        }
                        else
                        {
                            @* Si es el cliente real, ve sus opciones normales de cuenta *@
                            <a asp-action="PanelCliente" class="btn btn-primary py-2">
                                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                            </a>
                            
                            <form asp-controller="Acceso" asp-action="Logout" method="post" class="d-grid">
                                <button type="submit" class="btn btn-outline-danger py-2">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 text-muted small py-3">
                    Comunidad Heladería Jack Frost ❄️
                </div>

            </div>

        </div>
    </div>
</div>