@model List<HeladeriaJackFrost.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Proveedores</h2>
        <a asp-controller="Proveedor" asp-action="Crear" class="btn btn-success">Registrar Nuevo Proveedor</a>
    </div>
    
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del Contacto</th>
            <th>Empresa</th>
            <th>Teléfono</th>
            <th>Correo</th>
        </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdProveedor</td>
                    <td>@item.Nombre</td>
                    <td>@item.Empresa</td>
                    <td>@(!string.IsNullOrEmpty(item.Telefono) ? item.Telefono : "N/A")</td>
                    <td>@(!string.IsNullOrEmpty(item.Correo) ? item.Correo : "N/A")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No hay proveedores registrados todavía.</td>
            </tr>
        }
        </tbody>
    </table>
</div>