@{
    ViewData["Title"] = "Dashboard - Inicio";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="dashboard-wrapper" data-dashboard-url="@Url.Action("DashboardDatos", "Home")">
    <!-- Encabezado compacto en móvil -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 mb-md-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                    Turno Actual
                </span>
                <small class="text-muted fw-semibold" id="fechaActualTexto">@DateTime.Today.ToString("dd/MM/yyyy")</small>
            </div>
            <h1 class="h4 h3-md fw-bold mb-0 text-dark">
                <i class="bi bi-snow2 text-primary me-2"></i>Panel de Control — Jack Frost
            </h1>
        </div>
        <div class="d-grid d-sm-block">
            <button id="btnRecargarDatos" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualizar turno
            </button>
        </div>
    </div>

    <div id="dashboardError" class="alert alert-danger d-none" role="alert"></div>

    <!-- Fila 1: 3 KPIs Operativos (2 columnas en móvil para ahorrar scroll vertical) -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-4">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Ventas de Hoy</p>
                            <h3 class="h4 fw-bold mb-1 text-dark" id="kpiVentasHoyTotal">Bs. 0</h3>
                            <span class="badge bg-success-subtle text-success" id="kpiVentasHoyCantidad">0 ventas</span>
                        </div>
                        <div class="kpi-icon bg-primary-subtle text-primary d-none d-sm-flex">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">En Cola / Barra</p>
                            <h3 class="h4 fw-bold mb-1 text-warning-emphasis" id="kpiPedidosEnCurso">0</h3>
                            <span class="badge bg-warning-subtle text-warning-emphasis">Pendientes / Prep.</span>
                        </div>
                        <div class="kpi-icon bg-warning-subtle text-warning-emphasis d-none d-sm-flex">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Alertas de Stock</p>
                            <h3 class="h4 fw-bold mb-1 text-danger" id="kpiStockCritico">0 productos</h3>
                            <span class="badge bg-info-subtle text-info-emphasis" id="kpiStockTotal">0 uds. en total</span>
                        </div>
                        <div class="kpi-icon bg-danger-subtle text-danger d-none d-sm-flex">
                            <i class="bi bi-exclamation-octagon"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Estado de Ventas de Hoy + Top Más Vendidos Hoy -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h5 class="card-title fw-bold mb-0">Estado de Ventas (Hoy)</h5>
                    <small class="text-muted">Control de pedidos del día actual</small>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="chart-container chart-md" style="min-height: 240px;">
                        <canvas id="graficaEstadoVentasHoy"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold mb-0">Lo Más Pedido Hoy</h5>
                        <small class="text-muted">Top 5 productos con mayor salida en el turno</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">Rotación Hoy</span>
                </div>
                <div class="card-body">
                    <div class="chart-container chart-md" style="min-height: 240px;">
                        <canvas id="graficaTopProductosHoy"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Alertas de Reposición (Prioridad en celular) + Niveles de Stock -->
    <div class="row g-3 g-md-4">
        <div class="col-12 col-lg-5 order-1 order-lg-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold mb-0">Alertas de Reposición</h5>
                        <small class="text-muted">Stock crítico (&le; 15 unidades)</small>
                    </div>
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 340px;">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-3">Producto</th>
                                    <th>Categoría</th>
                                    <th class="text-end pe-3">Stock</th>
                                </tr>
                            </thead>
                            <tbody id="tablaAlertasStock">
                                <!-- Llenado por dashboard.js -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold mb-0">Niveles de Stock por Producto</h5>
                        <small class="text-muted">Rojo indica stock bajo (&le; 15 uds.)</small>
                    </div>
                    <span class="badge bg-info-subtle text-info-emphasis">Inventario</span>
                </div>
                <div class="card-body">
                    <div class="chart-container chart-lg" style="min-height: 300px;">
                        <canvas id="graficaStockProductos"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}