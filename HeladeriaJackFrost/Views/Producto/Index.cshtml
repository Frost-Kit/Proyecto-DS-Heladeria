@model List<HeladeriaJackFrost.ViewModels.ProductoViewModel>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Productos</h2>
        <a asp-controller="Producto" asp-action="Crear" class="btn btn-success">Registrar Nuevo Producto</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-5">
            <label for="idCategoria" class="form-label">Filtrar por categoría</label>
            <select id="idCategoria" name="idCategoria" class="form-select" asp-items="ViewBag.ListaCategorias">
                <option value="">Todas las categorías</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID Producto</th>
                    <th>Categoria</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ID_Producto</td>
                            <td>@item.Categoria</td>
                            <td>@item.Nombre</td>
                            <td>@item.Precio.ToString("N2")</td>
                            <td>@item.Stock</td>
                            <td class="text-center">
                                <a asp-action="Actualizar" asp-route-id="@item.ID_Producto"
                                   class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.ID_Producto"
                                   class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            @(ViewBag.IdCategoriaSeleccionada != null
                                ? "No hay productos en la categoría seleccionada."
                                : "No hay productos registrados todavía.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>