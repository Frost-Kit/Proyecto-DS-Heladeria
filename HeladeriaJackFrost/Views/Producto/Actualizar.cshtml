@model HeladeriaJackFrost.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Actualizar Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">Actualizar Producto</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Actualizar" method="post">
                        <input type="hidden" asp-for="ID_Producto" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control"
                                   pattern="[\s\S]*[A-Za-zÁÉÍÓÚÜÑáéíóúüñ][\s\S]*"
                                   title="Incluya al menos una letra; puede usar números y caracteres especiales." />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdCategoria" class="form-label">Categoría</label>
                            <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.ListaCategorias">
                                <option value="">Seleccione una categoría</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label">Precio</label>
                            <input asp-for="Precio" class="form-control" type="number" min="0.01" step="0.01" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Stock" class="form-label">Stock</label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" step="1" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
