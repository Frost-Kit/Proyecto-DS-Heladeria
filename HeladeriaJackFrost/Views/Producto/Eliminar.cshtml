@model HeladeriaJackFrost.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar eliminación</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <p>¿Está seguro de que desea eliminar este producto?</p>

                    <dl class="row">
                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>
                        <dt class="col-sm-4">Categoría</dt>
                        <dd class="col-sm-8">@Model.Categoria</dd>
                        <dt class="col-sm-4">Precio</dt>
                        <dd class="col-sm-8">@Model.Precio.ToString("N2")</dd>
                        <dt class="col-sm-4">Stock</dt>
                        <dd class="col-sm-8">@Model.Stock</dd>
                    </dl>

                    <form asp-action="Eliminar" asp-route-id="@Model.ID_Producto" method="post">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
